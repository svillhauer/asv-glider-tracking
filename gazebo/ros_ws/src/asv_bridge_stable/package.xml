<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>asv_bridge_stable</name>
  <version>0.1.0</version>
  <description>ROS 2 bridge for the stable reference policy: 27-D observation, glider dive, DAC dead-reckoning, forward-only surge.</description>
  <maintainer email="svillhauer@g.ucla.edu">svillhauer</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
